SKILL_PATH = Path(__file__).resolve().parent.parent / "skills/tekton-innerloop/SKILL.md"
ENV_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*\Z")
SUBSTITUTION = re.compile(
    r"\{\{.*?\}\}|\$\((?:workspaces|params|context|steps|tasks|results)\.[^)]*\)"
)
TEKTON_UNBOUND = re.compile(r"\$\((?:workspaces|params|context|steps|tasks|results)\.")
PAC_UNBOUND = re.compile(r"\{\{")
STARTED = ".tkn-innerloop-started"
RUNNER_VARS = ("WORKSPACE", "BASE_SHA", "HEAD_SHA", "HEAD_REF", "BASE_REF", "RESULTS", "CACHES")
PLAN_VERSION = 8
PAC_ANNOTATION = "pipelinesascode.tekton.dev/"
# PaC placeholders with a local equivalent; the runner supplies these shell variables.
PAC_BINDINGS = {
    "revision": "$HEAD_SHA",
    "source_branch": "$HEAD_REF",
    "target_branch": "$BASE_REF",
    "event_type": "pull_request",
}
PAC_BOUND = re.compile(r"\{\{\s*(" + "|".join(PAC_BINDINGS) + r")\s*\}\}")
DEFINITION_KIND = re.compile(r"^kind:\s*['\"]?(?:Pipeline|Task|StepAction)['\"]?\s*$", re.MULTILINE)
ENTRY_KIND = re.compile(r"^kind:\s*['\"]?(?:PipelineRun|Pipeline)['\"]?\s*$", re.MULTILINE)
# Bare names are looked up on the image PATH (the bash image keeps it in /usr/local/bin).
